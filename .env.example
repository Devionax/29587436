# =============================================================================
# Smart Checkout Upsell - environment template
#
# Copy this file to .env and fill in the values locally.
# .env is gitignored. Never commit real credentials.
# `shopify app dev` populates the Shopify values automatically after you log in;
# you only need to fill in the database values yourself.
# =============================================================================

# --- Shopify app credentials -------------------------------------------------
# Where: Shopify Dev Dashboard -> Apps -> <your app> -> Client ID / Client secret
# (https://dev.shopify.com/dashboard). In development the Shopify CLI writes
# these into .env for you when you run `shopify app dev`. Set them manually only
# for deployments that do not use the CLI.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public origin Shopify uses to reach this app.
# Development: the CLI sets this to your tunnel URL (https://<tunnel>.trycloudflare.com).
# Production: your deployed HTTPS origin, no trailing slash.
SHOPIFY_APP_URL=

# Comma-separated OAuth scopes. Must match [access_scopes] in shopify.app.toml.
# read_products powers the picker and storefront snapshots. read_orders exists only
# for order attribution; order data is protected customer data and needs Shopify
# approval for public distribution. Do not add write scopes.
SCOPES=read_products,read_orders

# The app handle from the Partner Dashboard (part of the app URL, for example
# "smart-checkout-upsell" in admin.shopify.com/store/<store>/apps/smart-checkout-upsell).
# Used only to build Shopify's hosted plan selection link. Not a secret.
SHOPIFY_APP_HANDLE=

# --- Neon PostgreSQL ---------------------------------------------------------
# Where: Neon console -> your project -> Connect.
# DATABASE_URL = pooled connection string (host contains "-pooler").
# DIRECT_URL   = direct/unpooled connection string; Prisma migrations use it.
# Both must end with ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- Application -------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# Optional. Only set this if the app is served from a custom shop domain.
# SHOP_CUSTOM_DOMAIN=

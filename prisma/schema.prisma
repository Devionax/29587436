generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Managed by @shopify/shopify-app-session-storage-prisma.
// Tokens live only here and are never sent to a browser or extension.
model Session {
  id                   String    @id
  shop                 String
  state                String
  isOnline             Boolean   @default(false)
  scope                String?
  expires              DateTime?
  accessToken          String
  userId               BigInt?
  firstName            String?
  lastName             String?
  email                String?
  accountOwner         Boolean   @default(false)
  locale               String?
  collaborator         Boolean?  @default(false)
  emailVerified        Boolean?  @default(false)
  refreshToken         String?
  refreshTokenExpires  DateTime?

  @@index([shop])
  @@index([expires])
}

enum InstallationStatus {
  PENDING
  INSTALLED
  UNINSTALLED
}

enum RuleStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MatchMode {
  ANY
  ALL
}

enum Surface {
  PRODUCT_PAGE
  CART_PAGE
  CHECKOUT
}

enum AnalyticsEventType {
  IMPRESSION
  CLICK
  ADD_ATTEMPT
  ADD_SUCCESS
  ADD_FAILURE
  ORDER_ATTRIBUTED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// Tenant root. Every shop-owned table is reachable from this row, and every
// query is scoped by its id.
model Shop {
  id                 String             @id @default(cuid())
  shopDomain         String             @unique
  name               String?
  currencyCode       String?
  installationStatus InstallationStatus @default(PENDING)
  shopifyPlan        String?
  isPlus             Boolean            @default(false)
  installedAt        DateTime?
  uninstalledAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  settings          ShopSettings?
  rules             RecommendationRule[]
  productSnapshots  ProductSnapshot[]
  analyticsEvents   AnalyticsEvent[]
  orderAttributions OrderAttribution[]
  subscription      Subscription?
  webhookReceipts   WebhookReceipt[]

  @@index([installationStatus])
}

model ShopSettings {
  id                 String   @id @default(cuid())
  shopId             String   @unique
  enabled            Boolean  @default(false)
  defaultHeading     String   @default("You may also like")
  maxOffers          Int      @default(3)
  productPageEnabled Boolean  @default(true)
  cartPageEnabled    Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model RecommendationRule {
  id                String     @id @default(cuid())
  shopId            String
  name              String
  description       String?
  status            RuleStatus @default(DRAFT)
  // Lower number wins. Ties resolve by offer position, then rule id.
  priority          Int        @default(100)
  matchMode         MatchMode  @default(ANY)
  heading           String?
  maxOffers         Int?
  showOnProductPage Boolean    @default(true)
  showOnCartPage    Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  shop              Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  triggers          TriggerProduct[]
  offers            RecommendedProduct[]
  analyticsEvents   AnalyticsEvent[]
  orderAttributions OrderAttribution[]

  @@index([shopId, status, priority])
  @@index([shopId, updatedAt])
}

model TriggerProduct {
  id         String   @id @default(cuid())
  shopId     String
  ruleId     String
  productGid String
  // Empty string means "any variant of this product".
  variantGid String   @default("")
  createdAt  DateTime @default(now())

  rule RecommendationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, productGid, variantGid])
  @@index([shopId, productGid])
}

model RecommendedProduct {
  id              String   @id @default(cuid())
  shopId          String
  ruleId          String
  productGid      String
  variantGid      String
  defaultQuantity Int      @default(1)
  minQuantity     Int      @default(1)
  maxQuantity     Int      @default(10)
  position        Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rule RecommendationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, variantGid])
  @@index([shopId, ruleId])
}

// Local projection of Shopify catalog data used by the storefront endpoint.
// Shopify remains the source of truth; this is refreshed by webhooks and syncs.
model ProductSnapshot {
  id               String   @id @default(cuid())
  shopId           String
  productGid       String
  title            String
  handle           String
  imageUrl         String?
  status           String
  availableForSale Boolean  @default(false)
  priceMin         Decimal? @db.Decimal(12, 2)
  priceMax         Decimal? @db.Decimal(12, 2)
  currencyCode     String?
  syncedAt         DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shop     Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants ProductVariantSnapshot[]

  @@unique([shopId, productGid])
  @@index([shopId, syncedAt])
}

model ProductVariantSnapshot {
  id              String   @id @default(cuid())
  shopId          String
  productId       String
  variantGid      String
  title           String
  price           Decimal  @db.Decimal(12, 2)
  compareAtPrice  Decimal? @db.Decimal(12, 2)
  availableForSale Boolean @default(false)
  position        Int      @default(0)
  syncedAt        DateTime

  product ProductSnapshot @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shopId, variantGid])
  @@index([productId])
}

model AnalyticsEvent {
  id              String             @id @default(cuid())
  shopId          String
  ruleId          String?
  eventType       AnalyticsEventType
  surface         Surface
  offerProductGid String
  offerVariantGid String?
  // Pseudonymous, generated per storefront session. Never a customer identifier.
  sessionKey      String
  dedupeKey       String             @unique
  occurredAt      DateTime
  receivedAt      DateTime           @default(now())
  metadata        Json?

  shop Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rule RecommendationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([shopId, occurredAt])
  @@index([shopId, ruleId, eventType])
  @@index([shopId, offerProductGid])
}

// Attribution derived from the cart marker set when an offer is accepted.
// This is an association, not proof of incrementality. One order can credit
// several offers, hence the composite uniqueness below.
model OrderAttribution {
  id              String   @id @default(cuid())
  shopId          String
  orderGid        String
  ruleId          String?
  offerProductGid String
  offerVariantGid String
  quantity        Int
  lineSubtotal    Decimal  @db.Decimal(12, 2)
  currencyCode    String
  attributedAt    DateTime @default(now())

  shop Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rule RecommendationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([orderGid, offerVariantGid])
  @@index([shopId, attributedAt])
  @@index([orderGid])
}

// Local reconciliation cache. Shopify App Pricing remains the billing truth.
model Subscription {
  id                     String             @id @default(cuid())
  shopId                 String             @unique
  planName               String
  status                 SubscriptionStatus @default(PENDING)
  shopifySubscriptionGid String?
  currentPeriodEnd       DateTime?
  lastVerifiedAt         DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model WebhookReceipt {
  id         String        @id @default(cuid())
  webhookId  String        @unique
  shopDomain String
  shopId     String?
  topic      String
  apiVersion String?
  status     WebhookStatus @default(RECEIVED)
  attempts   Int           @default(0)
  lastError  String?
  receivedAt DateTime      @default(now())
  processedAt DateTime?

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([shopDomain, topic])
  @@index([status])
}
